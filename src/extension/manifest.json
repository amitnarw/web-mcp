{
  "manifest_version": 3,
  "name": "web-mcp extension",
  "version": "0.2.0",
  "description": "A dedicated in-browser automation copilot: AI agents drive Chromium, each in its own tabs, with real-time visual feedback.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["claim.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "web-mcp",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
